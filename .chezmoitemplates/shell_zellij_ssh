# Auto-attach to zellij session on SSH login
if [[ -n "$SSH_TTY" ]] && [[ "$ZED_TERM" != "true" ]] && [[ -z "$ZELLIJ" ]]; then
	if zellij_bin=$(mise which zellij 2>/dev/null); then
		"$zellij_bin" attach --create default && exit
	else
		echo "zellij is not installed. Please run 'chezmoi apply' to install it."
	fi
	unset zellij_bin
fi
